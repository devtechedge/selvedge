# The pooled URL is used by the application at runtime.
DATABASE_URL="postgresql://user:password@host-pooler/selvedge?sslmode=require"
# The direct URL is used for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/selvedge?sslmode=require"
DATABASE_URL_TEST="postgresql://user:password@host-pooler/selvedge_test?sslmode=require"
DATABASE_URL_TEST_UNPOOLED="postgresql://user:password@host/selvedge_test?sslmode=require"
DATABASE_URL_E2E="postgresql://user:password@host-pooler/selvedge_e2e?sslmode=require"
DATABASE_URL_E2E_UNPOOLED="postgresql://user:password@host/selvedge_e2e?sslmode=require"
SESSION_PEPPER="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEMO_MODE="1"
ALLOW_PROD_SEED=""